# ==============================================================================
# VARIABLES DE ENTORNO: SISTEMA SGR - ILUSTRE MUNICIPALIDAD DE LA SERENA
# ==============================================================================

# 1. Configuración básica de Django
# Genera una clave propia con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=REEMPLAZA_POR_UNA_CLAVE_ALEATORIA_LARGA
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# 2. SQLite es la opción local predeterminada. Activa MySQL solo si ya está configurado.
USE_MYSQL=False
DB_NAME=matriz_sgr_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# 3. Almacenamiento de evidencias; usa la carpeta local media/ durante el desarrollo.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=

# 4. Política de carga y retención de evidencias.
EVIDENCE_MAX_FILE_SIZE=5242880
EVIDENCE_MAX_IMAGE_PIXELS=40000000
EVIDENCE_ALLOWED_FORMATS=JPEG,PNG,WEBP
EVIDENCE_RETENTION_DAYS=365

# 5. Orígenes adicionales; deja vacíos estos valores para una aplicación del mismo origen.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# 6. HTTPS: activa TRUST_PROXY_SSL_HEADER solo si Nginx/proxy sustituye
# X-Forwarded-Proto y Gunicorn no es accesible directamente desde Internet.
TRUST_PROXY_SSL_HEADER=False
# Proxies de confianza delante de Django (0 en local; 1 con Nginx en EC2; 2 con ALB + Nginx).
TRUSTED_PROXY_COUNT=0

# 7. Producción: configura HTTPS, cookies seguras y correo SMTP desde variables secretas.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
EMAIL_BACKEND=
# Para Gmail: smtp.gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# Usa una App Password de Google y configúrala solo en backend/.env.
EMAIL_HOST_USER=sgr@ejemplo.cl
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=sgr@ejemplo.cl

# 8. Verificación en dos pasos obligatoria por rol (RNF-004); vacío = opcional.
# En producción se recomienda: ADMINISTRADOR,COORDINADOR,DELEGADO
TWO_FACTOR_REQUIRED_ROLES=

# Bloqueo por intentos fallidos de inicio de sesión y 2FA (OWASP A07).
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_MAX_FAILED_ATTEMPTS_PER_IP=30
TWO_FACTOR_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# 8.1 API REST con JWT (SimpleJWT).
# Clave propia para firmar los tokens; vacío = usa SECRET_KEY. Genérala igual que SECRET_KEY.
JWT_SIGNING_KEY=
# Duración del access token (minutos) y del refresh token (horas).
JWT_ACCESS_MINUTES=15
JWT_REFRESH_HOURS=8
# Máximo de peticiones a /api/v1/auth/token/ y /refresh/ por IP.
API_AUTH_THROTTLE_RATE=20/min
# Swagger (/api/v1/docs/) visible sin sesión para usar "Authorize" con JWT.
# Los endpoints siguen exigiendo token. False = solo con sesión web iniciada.
API_DOCS_PUBLIC=True

# 9. Sesiones: duración máxima en segundos (8 horas) y cierre con el navegador.
SESSION_COOKIE_AGE=28800
SESSION_EXPIRE_AT_BROWSER_CLOSE=True

# 10. Content-Security-Policy: False (recomendado) = la política se aplica y
# bloquea recursos no autorizados; True = solo informa en la consola (diagnóstico).
CSP_REPORT_ONLY=False

# 11. Registro de eventos de seguridad; LOG_FILE vacío = solo consola (journald).
# La retención se define en journald (ver guía de despliegue, Ley 21.663). Con
# LOG_FILE, el archivo rota cada LOG_FILE_MAX_MB y conserva LOG_FILE_BACKUPS copias.
LOG_FILE_MAX_MB=10
LOG_FILE_BACKUPS=100
LOG_LEVEL=INFO
LOG_FILE=

# 12. Operación: alertas por correo, monitoreo, disponibilidad y respaldos.
ALERTAS_EMAIL=
MONITOR_URL=http://127.0.0.1:8000/health/?profundo=1
MONITOR_CA_FILE=
MONITOR_STATE_FILE=
MONITOR_DISK_ALERT_PCT=85
JORNADA_DIAS=0,1,2,3,4
JORNADA_HORAS=08:00-18:00
DISPONIBILIDAD_META_PCT=99.5
BACKUP_DIR=
BACKUP_LOCAL_DAYS=7
BACKUP_S3_PREFIX=respaldos/
